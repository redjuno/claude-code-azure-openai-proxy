# Copy this file to .env, then fill in your own Azure OpenAI values.
# Do not commit .env.

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource-name.openai.azure.com
AZURE_API_VERSION=2025-03-01-preview

# LiteLLM local proxy
LITELLM_HOST=127.0.0.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-local-claude-code-proxy

# Model Claude Code uses. Must match a model_name in config/litellm.config.yaml.
# Available out of the box: gpt-sol, gpt-astra
CLAUDE_CODE_MODEL_ALIAS=gpt-sol

# Optional Claude Code behavior
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
