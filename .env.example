# Copy .env.example to .env, then fill in your own Azure OpenAI values.
# Do not commit .env.

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource-name.openai.azure.com
AZURE_API_VERSION=2025-03-01-preview

# Optional Azure Cost HUD preflight. Set both to enable automatic tenant login
# and subscription access validation before Claude starts.
# CLAUDE_AZURE_TENANT_ID=your-tenant.onmicrosoft.com
# CLAUDE_AZURE_COST_SUBSCRIPTION_ID=your-subscription-id
# CLAUDE_AZURE_PREFLIGHT_TIMEOUT=5
# CLAUDE_AZURE_COST_REFRESH_SCRIPT=scripts/azure-cost-statusline.py

# Claude 티어별 Azure 배포 (opus=Sol, fable=Astra)
AZURE_DEPLOYMENT_OPUS=your-gpt-56-sol-deployment-name
AZURE_DEPLOYMENT_HAIKU=your-gpt-56-luna-deployment-name
AZURE_DEPLOYMENT_FABLE=your-gpt-6-astra-deployment-name

LITELLM_HOST=127.0.0.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-local-claude-code-proxy

# Claude Code에 노출할 티어별 별칭
CLAUDE_CODE_OPUS_ALIAS=opus
CLAUDE_CODE_HAIKU_ALIAS=haiku
CLAUDE_CODE_FABLE_ALIAS=fable

# 모델별 컨텍스트 창 (gpt-5.6-sol / gpt-6-astra = 922k input tokens)
CLAUDE_CODE_MAX_CONTEXT_TOKENS=922000

# Optional Claude Code behavior
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
